---
import { LinkButton } from 'mochi-ui';
import { navegacion } from '../data/contenido.js';
const { activo = '' } = Astro.props;
---

<header class="cabecera">
  <div class="envoltorio cabecera__interior">
    <a href="/" class="logo" aria-label="Horizon Sport, inicio">
      <span>Horizon</span><span class="logo__punto">.</span><span>Sport</span>
    </a>

    <nav class="menu menu--escritorio" aria-label="Principal">
      {
        navegacion.map((item) => (
          <a
            href={item.href}
            class:list={['menu__enlace', { 'menu__enlace--activo': activo === item.href }]}
            aria-current={activo === item.href ? 'page' : undefined}
          >
            {item.texto}
            {activo === item.href && <span class="menu__indicador" aria-hidden="true" />}
          </a>
        ))
      }
    </nav>

    <LinkButton href="/colabora" variant="accent" className="cabecera__cta">Colabora</LinkButton>
  </div>

  <!-- En móvil el menú pasa a una fila desplazable: sigue siendo navegable sin JS. -->
  <nav class="menu menu--movil" aria-label="Principal (móvil)">
    <div class="menu__pista">
      {
        navegacion.map((item) => (
          <a
            href={item.href}
            class:list={['menu__enlace', { 'menu__enlace--activo': activo === item.href }]}
            aria-current={activo === item.href ? 'page' : undefined}
          >
            {item.texto}
            {activo === item.href && <span class="menu__indicador" aria-hidden="true" />}
          </a>
        ))
      }
    </div>
  </nav>
</header>

<style>
  /* Con su propio nombre de transición, la cabecera no entra en la cortinilla del cambio de página:
     se queda quieta mientras la página cambia debajo. */
  .cabecera {
    position: sticky;
    top: 0;
    z-index: 40;
    background: rgba(7, 9, 12, 0.88);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--linea);
    view-transition-name: cabecera;
  }

  .cabecera__interior {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    min-height: 4.25rem;
  }

  .logo {
    font-family: var(--fuente);
    font-stretch: 125%;
    font-weight: 800;
    text-transform: uppercase;
    font-size: 0.95rem;
    letter-spacing: 0.01em;
    white-space: nowrap;
  }

  .logo__punto {
    color: var(--azul);
  }

  .menu--escritorio {
    display: flex;
    gap: 1.75rem;
    margin-left: auto;
  }

  /* El botón es de Mochi (React): los estilos con ámbito de Astro no le llegan sin :global. */
  :global(.cabecera__cta) {
    flex-shrink: 0;
  }

  .menu__enlace {
    position: relative;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--papel-medio);
    padding-block: 0.35rem;
    border-bottom: 2px solid transparent;
    white-space: nowrap;
    transition: color 0.18s ease;
  }

  .menu__enlace:hover {
    color: var(--papel);
  }

  .menu__enlace--activo {
    color: var(--papel);
  }

  /* Al pasar el ratón, una línea se traza bajo el apartado desde la izquierda y, al salir, se
     recoge hacia la derecha. Ocupa el hueco del borde, así que no mueve nada. */
  .menu__enlace::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -2px;
    height: 2px;
    background: var(--papel-tenue);
    transform: scaleX(0);
    transform-origin: 100% 50%;
    transition: transform var(--mochi-duration-snappy) var(--mochi-ease-snappy);
  }

  .menu__enlace:not(.menu__enlace--activo):hover::after {
    transform: scaleX(1);
    transform-origin: 0 50%;
  }

  /* El subrayado azul del apartado activo. Tiene nombre de transición propio: al cambiar de página,
     viaja desde el apartado de antes hasta el nuevo. Solo uno de los dos menús está visible a la
     vez, así que el nombre nunca se repite en pantalla. */
  .menu__indicador {
    position: absolute;
    left: 0;
    right: 0;
    bottom: -2px;
    height: 2px;
    background: var(--azul);
    view-transition-name: indicador-menu;
  }

  .menu--movil {
    display: none;
    border-top: 1px solid var(--linea);
  }

  .menu__pista {
    display: flex;
    gap: 1.4rem;
    overflow-x: auto;
    padding-inline: var(--margen);
    padding-block: 0.6rem;
    scrollbar-width: none;
  }

  .menu__pista::-webkit-scrollbar {
    display: none;
  }

  @media (max-width: 900px) {
    .menu--escritorio {
      display: none;
    }
    .menu--movil {
      display: block;
    }
    .cabecera__interior {
      justify-content: space-between;
    }

    /* Cada fila lleva su propio fondo para que la del menú pueda recogerse bajo la del logo (lo
       decide el script al bajar). La cabecera deja pasar los toques por donde ya no hay fila. */
    .cabecera {
      background: none;
      backdrop-filter: none;
      border-bottom: 0;
      pointer-events: none;
    }

    .cabecera__interior,
    .menu--movil {
      pointer-events: auto;
      background: rgba(7, 9, 12, 0.88);
      backdrop-filter: blur(10px);
    }

    .cabecera__interior {
      position: relative;
      z-index: 1;
    }

    .menu--movil {
      border-bottom: 1px solid var(--linea);
      transition:
        translate var(--mochi-duration-snappy) var(--mochi-ease-snappy),
        opacity var(--mochi-duration-fade-out) var(--mochi-ease-fade-out);
    }

    .cabecera--recogida .cabecera__interior {
      box-shadow: 0 1px 0 var(--linea);
    }

    .cabecera--recogida .menu--movil {
      translate: 0 -100%;
      opacity: 0;
      pointer-events: none;
    }
  }
</style>
