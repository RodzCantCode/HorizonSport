---
import { Button, TextField } from 'mochi-ui';
const { fondo = 'base' } = Astro.props;
---

<section class:list={['boletin', { 'boletin--alterno': fondo === 'alterno' }]} aria-labelledby="boletin-titulo">
  <div class="envoltorio boletin__interior">
    <h2 class="titular-seccion ancha boletin__titulo" id="boletin-titulo" data-revela="rotulo">
      El análisis, cada semana en tu correo
    </h2>

    <form class="boletin__form" method="post" action="#">
      <TextField
        client:visible
        className="boletin__campo"
        label="Tu correo electrónico"
        name="email"
        type="email"
        required
        placeholder="tu@empresa.com"
        autoComplete="email"
      />
      <Button type="submit" variant="accent" size="lg">Suscribirme</Button>
    </form>
  </div>
</section>

<style>
  .boletin {
    padding-block: clamp(2.75rem, 6vw, 4.5rem);
  }

  .boletin--alterno {
    background: var(--tinta-800);
    border-block: 1px solid var(--linea);
  }

  .boletin__interior {
    display: flex;
    flex-wrap: wrap;
    gap: 1.75rem 3rem;
    align-items: center;
    justify-content: space-between;
  }

  .boletin__titulo {
    max-width: 20ch;
  }

  .boletin__form {
    display: flex;
    gap: 0.6rem;
    flex-wrap: wrap;
  }

  /* Campo de Mochi (isla de React): sin :global no le llegan los estilos con ámbito. */
  .boletin__form :global(.boletin__campo) {
    width: auto;
    min-width: 15rem;
    flex: 1;
  }
</style>
