---
import { LinkButton } from 'mochi-ui';
import Marcador from './Marcador.astro';

const { episodio, resumen = false } = Astro.props;

// La duración no se conoce hasta que el episodio está publicado del todo, así que
// se omite en lugar de inventarla.
const extras = [episodio.duracion].filter(Boolean);
// La miniatura repite el enlace del botón: va fuera del orden de tabulación y oculta a lectores
// de pantalla, para que no oigan dos veces el mismo enlace.
const miniatura = episodio.url && episodio.miniatura;
---

<article
  class:list={['episodio', 'fila-trazada', { 'episodio--sin-miniatura': !miniatura }]}
  data-revela="fila"
>
  <div class="episodio__numero estrecha" aria-hidden="true">Ep <Marcador valor={episodio.numero} /></div>

  {
    miniatura && (
      <a
        class="episodio__miniatura cortinilla"
        data-revela="cortinilla"
        href={episodio.url}
        rel="noopener"
        tabindex="-1"
        aria-hidden="true"
      >
        <img
          src={`/miniaturas/${miniatura}-960.webp`}
          srcset={`/miniaturas/${miniatura}-480.webp 480w, /miniaturas/${miniatura}-960.webp 960w`}
          sizes="(max-width: 700px) 100vw, (max-width: 1024px) 12rem, 16rem"
          width="960"
          height="540"
          alt=""
          loading="lazy"
          decoding="async"
        />
      </a>
    )
  }

  <div class="episodio__texto">
    <h3 class="episodio__titulo">
      <span class="solo-lectores">Episodio {episodio.numero}: </span>{episodio.titulo}
    </h3>
    <p class="dato episodio__meta">
      {episodio.invitado} · {episodio.contexto} · <time datetime={episodio.fecha}>{episodio.fechaTexto}</time>{extras.map((e) => <>{' · '}{e}</>)}
    </p>
    {resumen && <p class="parrafo episodio__resumen">{episodio.resumen}</p>}
  </div>

  <div class="episodio__accion">
    {episodio.url && (
      <LinkButton href={episodio.url} variant="surface" rel="noopener">
        Ver el episodio
      </LinkButton>
    )}
  </div>
</article>

<style>
  .episodio {
    display: grid;
    grid-template-columns: 5rem 16rem minmax(0, 1fr) auto;
    grid-template-areas: 'numero miniatura texto accion';
    gap: 1.5rem;
    align-items: start;
    padding-block: 1.75rem;
  }

  .episodio--sin-miniatura {
    grid-template-columns: 5rem minmax(0, 1fr) auto;
    grid-template-areas: 'numero texto accion';
  }

  .episodio__numero {
    grid-area: numero;
    padding-top: 0.5rem;
  }

  /* El borde, el radio y el fondo los pone .cortinilla (global.css). */
  .episodio__miniatura {
    grid-area: miniatura;
  }

  .episodio__miniatura img {
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }

  /* La miniatura es un enlace: al pasar el ratón la imagen se acerca un poco dentro de su marco. */
  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .episodio__miniatura:hover img {
      transform: scale(1.05);
    }
  }

  .episodio__texto {
    grid-area: texto;
  }

  .episodio__accion {
    grid-area: accion;
  }

  .episodio__titulo {
    font-weight: 600;
    font-size: clamp(1.2rem, 2.3vw, 1.6rem);
    line-height: 1.25;
    letter-spacing: -0.015em;
    margin: 0;
    max-width: 28ch;
  }

  .episodio__meta {
    margin-top: 0.5rem;
  }

  .episodio__resumen {
    margin-top: 0.85rem;
    font-size: 0.9375rem;
    max-width: 58ch;
  }

  /* Con miniatura no caben cuatro columnas: el botón baja bajo el texto. */
  @media (min-width: 701px) and (max-width: 1024px) {
    .episodio:not(.episodio--sin-miniatura) {
      grid-template-columns: 5rem 12rem minmax(0, 1fr);
      grid-template-areas:
        'numero miniatura texto'
        'numero miniatura accion';
      row-gap: 1rem;
    }
  }

  @media (max-width: 700px) {
    .episodio,
    .episodio--sin-miniatura {
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas: 'numero' 'miniatura' 'texto' 'accion';
      gap: 0.75rem;
    }
    .episodio__numero {
      padding-top: 0;
    }
  }
</style>
