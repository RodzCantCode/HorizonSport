---
// Portada de espera. Mientras está activa, `vercel.json` reescribe cualquier ruta
// aquí: el resto del sitio no es alcanzable hasta el lanzamiento.
// Para devolver la web completa: revertir el commit que la puso, o mover de nuevo
// `src/paginas-en-espera/` a `src/pages/` y borrar los `rewrites` de vercel.json.
import '../styles/global.css';
import { marca } from '../data/contenido.js';

// Instante del estreno con zona horaria explícita (CEST, UTC+2 en septiembre):
// así la cuenta atrás es correcta desde cualquier país.
const ESTRENO = '2026-09-04T19:00:00+02:00';
const HORA_TEXTO = 'hoy a las 19:00 (hora peninsular)';

const VIDEO = 'https://www.youtube.com/watch?v=-JBS4m7dXkM&t=13s';

const titulo = `${marca.nombre} — Estreno ${HORA_TEXTO}`;
const descripcion =
  'El podcast del negocio del deporte se estrena hoy a las 19:00. Primer episodio: Santi Higuera, de pelear en el anonimato a WOW FC.';
const canonica = new URL(Astro.url.pathname, Astro.site).href;
const imagen = new URL('/og-estreno.jpg', Astro.site).href;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titulo}</title>
    <meta name="description" content={descripcion} />
    <meta name="theme-color" content="#07090C" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href={canonica} />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonica} />
    <meta property="og:site_name" content={marca.nombre} />
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:image" content={imagen} />
    <meta property="og:image:width" content="1280" />
    <meta property="og:image:height" content="720" />
    <meta property="og:locale" content="es_ES" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={imagen} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,100..900&display=swap"
    />
  </head>

  <body class="espera">
    <main class="espera__caja">
      <p class="estrecha espera__marca">{marca.nombre}</p>

      <h1 class="ancha espera__titular" data-titular>
        Hoy a las <span class="espera__hora">19:00</span>
      </h1>

      <p class="espera__linea" data-linea>
        Se estrena el primer episodio y abre la web.
      </p>

      <!--
        Los dígitos cambian cada segundo: se ocultan al lector de pantalla y en su
        lugar va una frase estática con la misma información.
      -->
      <p class="visualmente-oculto" data-alternativa>
        El estreno es {HORA_TEXTO}.
      </p>

      <div class="cuenta" data-cuenta aria-hidden="true" hidden>
        <div class="cuenta__par">
          <span class="ancha cuenta__cifra" data-horas>00</span>
          <span class="estrecha cuenta__unidad">horas</span>
        </div>
        <div class="cuenta__par">
          <span class="ancha cuenta__cifra" data-minutos>00</span>
          <span class="estrecha cuenta__unidad">min</span>
        </div>
        <div class="cuenta__par">
          <span class="ancha cuenta__cifra" data-segundos>00</span>
          <span class="estrecha cuenta__unidad">seg</span>
        </div>
      </div>

      <a class="boton boton--solido espera__cta" href={VIDEO} rel="noopener">
        Ver el estreno en YouTube
      </a>
    </main>

    <script is:inline define:vars={{ ESTRENO }}>
      (function () {
        const destino = new Date(ESTRENO).getTime();
        const caja = document.querySelector('[data-cuenta]');
        const titular = document.querySelector('[data-titular]');
        const linea = document.querySelector('[data-linea]');
        const alternativa = document.querySelector('[data-alternativa]');
        const horas = document.querySelector('[data-horas]');
        const minutos = document.querySelector('[data-minutos]');
        const segundos = document.querySelector('[data-segundos]');

        // La cuenta atrás nace oculta: si el JS falla, la página sigue diciendo la
        // hora en el titular en vez de enseñar tres ceros congelados.
        caja.hidden = false;

        const dos = (n) => String(n).padStart(2, '0');

        function pintar() {
          const resto = destino - Date.now();

          if (resto <= 0) {
            caja.hidden = true;
            titular.textContent = 'Ya está fuera';
            linea.textContent = 'Primer episodio disponible.';
            alternativa.textContent = 'El primer episodio ya está publicado.';
            return true;
          }

          const total = Math.floor(resto / 1000);
          horas.textContent = dos(Math.floor(total / 3600));
          minutos.textContent = dos(Math.floor(total / 60) % 60);
          segundos.textContent = dos(total % 60);
          return false;
        }

        if (!pintar()) {
          const tic = setInterval(() => {
            if (pintar()) clearInterval(tic);
          }, 1000);
        }
      })();
    </script>
  </body>
</html>

<style>
  .espera {
    min-height: 100dvh;
    display: grid;
    place-items: center;
    padding: var(--margen);
  }

  .espera__caja {
    width: 100%;
    max-width: 54rem;
    text-align: center;
  }

  .espera__marca {
    color: var(--papel-medio);
    margin-bottom: clamp(2rem, 6vw, 3.5rem);
  }

  .espera__titular {
    font-size: clamp(2.25rem, 10vw, 6rem);
    margin-bottom: 1.5rem;
  }

  /* La hora siempre en su propia línea: es el dato que la gente viene a leer. */
  .espera__hora {
    display: block;
  }

  .espera__linea {
    color: var(--papel-medio);
    font-size: clamp(1rem, 2.4vw, 1.25rem);
    max-width: 34ch;
    margin-inline: auto;
    text-wrap: balance;
  }

  .cuenta {
    display: flex;
    justify-content: center;
    gap: clamp(1.5rem, 6vw, 3.5rem);
    margin-top: clamp(2.5rem, 7vw, 4rem);
    padding-top: clamp(2.5rem, 7vw, 4rem);
    border-top: 1px solid var(--linea);
  }

  /* `display: flex` gana al atributo `hidden` del navegador: hay que decirlo aquí
     o al llegar a cero se quedan tres ceros colgados en pantalla. */
  .cuenta[hidden] {
    display: none;
  }

  .cuenta__par {
    display: grid;
    gap: 0.6rem;
  }

  .cuenta__cifra {
    font-size: clamp(2.25rem, 9vw, 4rem);
    color: var(--azul);
  }

  .cuenta__unidad {
    font-size: 0.6875rem;
  }

  .espera__cta {
    margin-top: clamp(2.5rem, 7vw, 3.5rem);
  }

  .visualmente-oculto {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
</style>
