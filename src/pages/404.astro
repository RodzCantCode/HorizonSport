---
import { LinkButton } from 'mochi-ui';
import Base from '../layouts/Base.astro';
import TitularCinetico from '../components/TitularCinetico.astro';
---

<Base titulo="Página no encontrada">
  <section class="perdida">
    <div class="envoltorio">
      <p class="estrecha">Error 404</p>
      <TitularCinetico class="titular-pagina ancha perdida__titulo" texto="Esta página no existe" />
      <p class="entradilla perdida__texto">
        El enlace está roto o la página cambió de sitio.
      </p>
      <div class="fila perdida__acciones">
        <LinkButton href="/" variant="accent">Volver al inicio</LinkButton>
        <LinkButton href="/episodios" variant="surface">Ver episodios</LinkButton>
      </div>
    </div>
  </section>
</Base>

<style>
  .perdida {
    padding-block: clamp(4rem, 12vw, 9rem);
  }

  .perdida__titulo {
    margin-top: 0.9rem;
  }

  .perdida__texto {
    margin-top: 1.35rem;
  }

  .perdida__acciones {
    margin-top: 2rem;
  }
</style>
